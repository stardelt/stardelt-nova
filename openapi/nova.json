      "NewConnection": {
        "type": "object",
        "description": "`POST /api/connections` body. `secret` holds the values; they are written to the store and\nnever returned.",
        "required": [
          "name",
          "type",
          "scope",
          "secret"
        ],
        "properties": {
          "config": {
            "type": "object",
