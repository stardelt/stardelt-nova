            "additionalProperties": {
              "type": "string",
              "writeOnly": true
            },
            "propertyNames": {
              "type": "string",
              "writeOnly": true
            }
          },
          "type": {
            "type": "string"
          },
          "usableBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OidcMe": {
        "type": "object",
        "description": "`/api/me` in `oidc` mode: claims, never tokens. Nova still talks to Trino and\nLakekeeper with its service connection, and says so (`identity_forwarding`).",
        "required": [
