      "WarehouseInfo": {
        "type": "object",
        "description": "OpenAPI shapes for the catalog routes (first slice of ticket #107).\n\nNova proxies these bodies — from Lakekeeper upstream, or from the\nin-memory demo shapes in `demo.rs` — so the structs below mirror the\nproxied Iceberg REST shapes rather than being constructed anywhere.\n`#[schema(rename = …)]` keeps the hyphenated Iceberg field names.",
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The Lakekeeper warehouse id, or `\"demo\"` in demo mode."
