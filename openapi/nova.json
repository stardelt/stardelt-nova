    "/api/me": {
      "get": {
        "tags": [
          "public"
        ],
        "description": "The caller: static user in `dev` mode, verified claims (never tokens) in `oidc` mode. The `oidc` shape is the documented `OidcMe` superset of this one.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user, auth mode, demo flag and warehouse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectionView": {
        "type": "object",
        "description": "One row of `GET /api/connections`. Never carries a value.",
        "required": [
          "name",
          "scope",
          "type",
          "config",
          "secretKeys",
          "version"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "lastRotated": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ownerGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "secretKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names of the secret fields."
          },
          "sync": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncView",
                "description": "`Ready` and its reason from the resource's status; absent for a personal connection."
              }
            ]
          },
          "type": {
            "type": "string"
          },
          "usableBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ConnectionsResponse": {
        "type": "object",
        "description": "`GET /api/connections` answer.",
        "required": [
          "connections"
        ],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionView"
            }
          }
        }
      },
      "CreateNamespaceRequest": {
        "type": "object",
        "required": [
          "namespace"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Schema name to create (surrounding whitespace is trimmed)."
          }
        }
      },
      "CreateNamespaceResponse": {
        "type": "object",
